@model List<Partido>
@{
    ViewData["Title"] = "Seleccionar Partido";
    var cedula = ViewBag.Cedula;
}

<h2>@ViewData["Title"]</h2>
<h4>Cédula: @cedula</h4>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="RegistrarVoto" method="post">
    <input type="hidden" name="cedula" value="@cedula" />

    <div class="form-group">
        <label>Seleccione un partido:</label>
        <select name="partidoId" class="form-control" required>
            @foreach (var partido in Model)
            {
                <option value="@partido.Id">@partido.Nombre (@partido.Siglas)</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success">Registrar Voto</button>
</form>