@model List<ResultadoVotacion>
@{
    ViewData["Title"] = "Resultados de Votación";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Partido</th>
            <th>Votos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var resultado in Model)
        {
            <tr>
                <td>@resultado.Partido</td>
                <td>@resultado.Votos</td>
            </tr>
        }
    </tbody>
</table>