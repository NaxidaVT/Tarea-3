@model VotacionApp.WebMVC.Models.PartidoPoliticoViewModel

@{
    ViewData["Title"] = "Detalles del Partido Político";
}

<h1>Detalles del Partido Político</h1>

<div>
    <h4>Partido Político</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Siglas)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Siglas)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.PartidoPoliticoId" class="btn btn-info">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>